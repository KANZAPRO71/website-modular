{
  "name": "next-ecommerce-shopco",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "cross-env NEXT_DEV_URL=http://localhost:3100 ORCHESTRATOR_PORT=8788 NEXT_PUBLIC_DUPLEX_WS_URL=ws://localhost:8788 concurrently \"next dev --port 3100\" \"wait-on http://localhost:3100 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && npm run orchestrator:build && electron-builder",
    "electron:build:win": "npm run build && npm run orchestrator:build && electron-builder --win",
    "electron:build:mac": "npm run build && npm run orchestrator:build && electron-builder --mac",
    "electron:build:linux": "npm run build && npm run orchestrator:build && electron-builder --linux",
    "orchestrator:build": "cd ../orchestrator && npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@reduxjs/toolkit": "^2.2.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.2.1",
    "framer-motion": "^11.5.4",
    "holy-loader": "^2.3.7",
    "lucide-react": "^0.438.0",
    "next": "14.2.7",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "react-simple-star-rating": "^5.1.7",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.0",
    "vaul": "^0.9.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  }
}
